_schema-version: "3.3.0"
ID: ai-day-planner
extends: ai-day-planner

# ==============================================================================
# Production MTA Extension Descriptor
# Overrides mta.yml properties for the PROD environment.
# ==============================================================================

modules:
  - name: ai-day-planner
    parameters:
      memory: 1024M
      disk-quota: 2048M
      instances: 2
    properties:
      NODE_ENV: production

resources:
  - name: ai-day-planner-db
    parameters:
      service: postgresql-db
      service-plan: standard
      config:
        engine: postgres
