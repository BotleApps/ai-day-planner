# PostgreSQL on SAP BTP
# For local development: postgresql://user:password@localhost:5432/ai-day-planner
# For CF deployment: derived automatically from the service binding by deploy.sh
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai-day-planner

# ---------------------------------------------------------------
# NextAuth.js v5
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=

# Full URL of the deployed app (no trailing slash)
# Local development: http://localhost:3000
# SAP BTP CF: https://ai-day-planner.cfapps.<region>.hana.ondemand.com
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------
# Google OAuth 2.0
# Create credentials at: https://console.cloud.google.com/
#   APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
#   Authorized redirect URIs must include: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------
# SAP BTP Cloud Foundry — static deployment config
# These are safe to commit (no secrets). Copy to .env.local and fill in.
CF_API=https://api.cf.eu12.hana.ondemand.com
CF_ORG=
CF_SPACE=
# Public URL of the CF app (same as NEXTAUTH_URL when deployed)
CF_APP_URL=https://ai-day-planner.cfapps.eu12.hana.ondemand.com
# Name of the PostgreSQL service instance on SAP BTP
CF_DB_SERVICE_NAME=ai-day-planner-db

# ---------------------------------------------------------------
# SAP AI Core — NO server environment variables needed.
# Credentials are entered by the user in the Settings page (/settings/intelligence)
# and stored in their browser's localStorage. They are sent to the
# Next.js API routes (/api/ai/chat, /api/ai/models) at request time.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Native Google Sign-In (iOS / Android via Capacitor)
# Per-platform OAuth client IDs. The backend accepts an ID token whose `aud`
# matches ANY of these, so native sign-ins map to the same Google account as
# the web flow. Client IDs are public (not secrets).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Exposed to the client bundle (inlined at build time) for the native SDK.
# Web client ID doubles as the serverClientId on Android.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---------------------------------------------------------------
# Capacitor — deployed web app URL the native shell loads.
# Leave unset for local dev (auto-detects http://localhost:3000).
CAP_SERVER_URL=

# ---------------------------------------------------------------
# CI-only: non-interactive Cloud Foundry auth (GitHub Actions).
# Do NOT use SSO in CI. Prefer a dedicated technical user.
CF_USERNAME=
CF_PASSWORD=
# Optional identity-provider origin, if your platform requires one.
CF_ORIGIN=
