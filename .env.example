# MongoDB Connection
# For Vercel MongoDB Atlas integration, this will be automatically set when you connect the database
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Database name (defaults to 'ai-day-planner' if not set)
MONGODB_DB=ai-day-planner

# Optional: Node environment (set automatically by Vercel)
# NODE_ENV=production

# ---------------------------------------------------------------
# SAP AI Core — NO server environment variables needed.
# Credentials are entered by the user in the Settings page (/settings)
# and stored in their browser's localStorage. They are sent to the
# Next.js API routes (/api/ai/chat, /api/ai/models) at request time.
# ---------------------------------------------------------------
