# =============================================================================
# .env.example — Copy to .env.local for dev, set in Render dashboard for prod.
# =============================================================================
# Never commit .env, .env.local, or .env.production. Only this template lives
# in git. Render injects DATABASE_URL and NEXTAUTH_URL automatically when the
# Blueprint (render.yaml) is applied; everything else you set in the dashboard.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Render injects this from the managed Postgres instance. For local dev,
# point at a local Postgres or the external connection string of a Render DB.
DATABASE_URL=postgresql://user:password@localhost:5432/sortedplan

# Set to "false" ONLY for local dev with a self-signed cert. Defaults to strict
# certificate verification in production. Leave unset on Render.
# DB_SSL_REJECT_UNAUTHORIZED=false


# ─── NextAuth ────────────────────────────────────────────────────────────────
# NextAuth v5 reads either AUTH_SECRET or NEXTAUTH_SECRET — set both for safety.
# Generate: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# Public canonical URL of the deployed app. Render injects RENDER_EXTERNAL_URL
# automatically (see render.yaml). For local dev, set to http://localhost:3000.
NEXTAUTH_URL=http://localhost:3000


# ─── Encryption key for AI credentials at rest ──────────────────────────────
# 64 hex chars (= 32 random bytes). Generated once and stored in the secret
# manager — DO NOT regenerate, or all previously-encrypted UserSettings rows
# become unreadable.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=


# ─── Google OAuth — server-side (token verification audiences) ───────────────
# These three are accepted as the `aud` claim of any incoming Google ID token,
# so a user gets the same identity (Google `sub`) across web, iOS, and Android.

# Web OAuth client (Type: Web application)
#   Authorized redirect URIs must include: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# iOS OAuth client (Type: iOS, Bundle ID: com.sortedplan.app)
GOOGLE_IOS_CLIENT_ID=650060721357-j01pfklfe15a5be1aacc408v5j9dpon2.apps.googleusercontent.com

# Android OAuth client (Type: Android, Package: com.sortedplan.app, SHA-1: registered keystore)
GOOGLE_ANDROID_CLIENT_ID=650060721357-6dl26dt2jq4h5ibm9nostlt8q8pdt1u0.apps.googleusercontent.com


# ─── Google OAuth — client-side (baked into JS bundle at build time) ─────────
# Must be present when `next build` runs — they end up in the public JS bundle
# and tell the native shells which client ID to ask Google for. Setting them
# at runtime does nothing.

NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=650060721357-j01pfklfe15a5be1aacc408v5j9dpon2.apps.googleusercontent.com


# ─── Capacitor — set ONLY when running `npx cap sync` ────────────────────────
# The URL the native shell loads at runtime. Set this in your shell before
# `cap sync`, not in this file.
#   Local dev    →  http://localhost:3000  (iOS sim) or http://10.0.2.2:3000 (Android emulator)
#   Render prod  →  https://sortedplan-web.onrender.com
# CAP_SERVER_URL=https://sortedplan-web.onrender.com
