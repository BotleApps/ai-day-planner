generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  destination String   @default("")
  coverImage  String   @default("")
  status      String   @default("draft")
  startDate   String
  endDate     String
  createdBy   String
  shareLink   String?  @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Preferences (flattened)
  wakeUpTime           String  @default("07:00")
  sleepTime            String  @default("22:00")
  pace                 String  @default("moderate")
  breakFrequency       Int     @default(120)
  breakDuration        Int     @default(15)
  travelBuffer         Int     @default(30)
  mealBreakfast        String?
  mealLunch            String?
  mealDinner           String?
  activityTypes        String[] @default([])
  accessibility        String[] @default([])
  dietaryRestrictions  String[] @default([])
  interests            String[] @default([])

  days DayPlan[]
  sharedAccess SharedAccess[]
  shareLinks   ShareLink[]

  @@index([createdBy])
}

model DayPlan {
  id          String  @id @default(cuid())
  planId      String
  date        String
  dayNumber   Int
  title       String?
  description String?
  notes       String?
  startTime   String?
  endTime     String?

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([planId, date])
  @@unique([planId, dayNumber])
  @@index([planId])
}

model Activity {
  id              String   @id @default(cuid())
  dayPlanId       String
  title           String
  description     String?
  type            String   @default("activity")
  startTime       String
  duration        Int
  endTime         String?
  location        String?
  address         String?
  status          String   @default("planned")
  priority        String   @default("medium")
  notes           String?
  cost            Float?
  currency        String?
  weatherDependent Boolean @default(false)
  isBreak         Boolean  @default(false)
  aiSuggested     Boolean  @default(false)
  order           Int      @default(0)
  color           String?
  icon            String?
  imageUrl        String?
  mapsUrl         String?

  dayPlan DayPlan @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)

  @@index([dayPlanId])
}

model SharedAccess {
  id          String     @id @default(cuid())
  userId      String
  userEmail   String     @default("")
  userName    String     @default("")
  planId      String
  permission  String     @default("view")
  linkId      String?
  plan        Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  shareLink   ShareLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  accessedAt  DateTime   @default(now())

  @@unique([userId, planId])
  @@index([userId])
}

model ShareLink {
  id         String         @id @default(cuid())
  planId     String
  token      String         @unique
  permission String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  plan       Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  members    SharedAccess[]

  @@index([planId])
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  time        String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Checklist {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  dueDate     String?
  dueTime     String?
  planId      String?
  shareLink   String?  @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        ChecklistItem[]
  sharedAccess SharedChecklistAccess[]
  shareLinks   ChecklistShareLink[]

  @@index([userId])
  @@index([planId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  groupName   String    @default("")
  completed   Boolean   @default(false)
  order       Int       @default(0)
  dueDate     String?
  notes       String    @default("")

  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  authorId    String
  authorName  String   @default("")
  title       String
  description String   @default("")
  category    String   @default("general")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ChecklistTemplateItem[]

  @@index([authorId])
  @@index([isPublished])
  @@index([category])
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  templateId String
  title      String
  groupName  String            @default("")
  order      Int               @default(0)
  notes      String            @default("")

  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model SharedChecklistAccess {
  id          String    @id @default(cuid())
  userId      String
  userEmail   String    @default("")
  userName    String    @default("")
  checklistId String
  permission  String    @default("view")
  linkId      String?
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  shareLink   ChecklistShareLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  accessedAt  DateTime  @default(now())

  @@unique([userId, checklistId])
  @@index([userId])
}

model ChecklistShareLink {
  id          String                  @id @default(cuid())
  checklistId String
  token       String                  @unique
  permission  String
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  checklist   Checklist               @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  members     SharedChecklistAccess[]

  @@index([checklistId])
}

model UserSettings {
  userId          String   @id
  aiEnabled       Boolean  @default(false)
  provider        String   @default("sap")
  // SAP AI Core
  clientId        String   @default("")
  clientSecretEnc String   @default("")
  authUrl         String   @default("")
  apiUrl          String   @default("")
  resourceGroup   String   @default("default")
  deploymentId    String   @default("")
  backend         String   @default("openai")
  modelName       String   @default("")
  // Google Gemini
  geminiApiKeyEnc String   @default("")
  geminiModel     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
